# Copy this file to .env, then fill in every blank value.
# Never commit .env to git.

NODE_ENV=development
PORT=3000

# Absolute path recommended in production, e.g. /var/data/rbu.sqlite
# A relative path is resolved from the folder where you run "npm start".
DATABASE_PATH=./data/app.sqlite

# Used for cookie origin checks (and Socket.io allowed origins in Phase 4).
# Development: http://localhost:3000
# Production:  the exact public HTTPS origin, e.g. https://sports.example.edu
APP_ORIGIN=http://localhost:3000

# Required. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates existing sessions and any pending OTP codes.
JWT_SECRET=

# Session lifetime in minutes. Allowed range: 5 to 1440.
JWT_EXPIRES_MINUTES=120

# Reverse proxy hops. Render/Railway usually need 1. Leave 0 locally.
TRUST_PROXY=0

# SMTP is used for registration verification codes (OTP).
#
# Development without SMTP:
#   Leave SMTP_HOST and MAIL_FROM empty. The server prints the OTP in the
#   terminal where "npm run dev" is running. Never share that output.
#
# Production:
#   SMTP_HOST and MAIL_FROM are REQUIRED. The server refuses to start without
#   them, so students cannot create accounts they are unable to verify.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
